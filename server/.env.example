PORT=5000
APP_VERSION=1.0.0
MAX_UPLOAD_MB=8
INFERENCE_TIMEOUT_MS=180000
PYTHON_BIN=python3
MODEL_DEVICE=cpu
MODEL_CHECKPOINT=/var/www/cpfedst-webapp/models/E4_v4_cpfedst_stage2.pt
PFEDST_CODE_DIR=/var/www/cpfedst-webapp/ml/vendor
ML_WORKER_PATH=/var/www/cpfedst-webapp/ml/inference_worker.py
EXPERIMENT_METADATA=/var/www/cpfedst-webapp/config/experiment-metadata.json
FRONTEND_DIST=/var/www/cpfedst-webapp/frontend/dist
DEMO_MODE=false
DEBUG_MODEL_WORKER=false

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_COLLECTION=predictions
